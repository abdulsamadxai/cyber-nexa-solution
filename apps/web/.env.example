# ─────────────────────────────────────────────────────────────
# Cyber Nexa Solution — Web / Frontend Environment
# ─────────────────────────────────────────────────────────────
#
# LOCAL DEVELOPMENT:
# Leave VITE_API_URL empty (Vite dev server proxies /api & /uploads to VITE_PROXY_TARGET).
#
# PRODUCTION DEPLOYMENT (e.g., Hostinger, Vercel):
# - If frontend and API are served from the same domain or behind a reverse proxy (e.g., Nginx):
#   Leave VITE_API_URL empty.
# - If frontend and API are on separate domains/subdomains (e.g. yourdomain.com vs api.yourdomain.com):
#   Set VITE_API_URL to the public API URL (e.g. https://api.yourdomain.com).
#
VITE_API_URL=
VITE_PROXY_TARGET=http://localhost:4000

# Optional: Cloudflare Turnstile site key (if enabled on the backend)
VITE_TURNSTILE_SITE_KEY=
