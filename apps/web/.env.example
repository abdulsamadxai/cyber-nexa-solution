# URL of the Amanah API. In development the Vite dev server proxies /api and
# /uploads to VITE_PROXY_TARGET, so you can leave VITE_API_URL empty locally.
VITE_API_URL=
VITE_PROXY_TARGET=http://localhost:4000
# Optional: Cloudflare Turnstile site key (only if you enable Turnstile on the API)
VITE_TURNSTILE_SITE_KEY=
