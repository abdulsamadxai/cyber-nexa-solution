# ─────────────────────────────────────────────────────────────
# Cyber Nexa Solution — API environment
# Copy this file to `apps/api/.env` and fill in the values.
# Never commit the real .env (it is git-ignored).
# ─────────────────────────────────────────────────────────────

# Core -----------------------------------------------------------------
# Set to 'production' on Hostinger/live servers, 'development' locally
NODE_ENV=development
PORT=4000

# PostgreSQL connection string.
# Local:      postgresql://postgres:postgres@localhost:5432/amanah
# Hostinger:  postgresql://u123456789_user:yourPassword@127.0.0.1:5432/u123456789_dbname
# Cloud/Neon: postgresql://USER:PASSWORD@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/amanah

# Secret used to sign sessions & tokens. MUST be at least 32 characters.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Public URLs (used for links in emails, CORS, and cookie/CSRF origin checks)
# On Hostinger: set these to your real domain (e.g. https://yourdomain.com)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# Extra comma-separated origins allowed by CORS (optional; FRONTEND_URL is always allowed)
CORS_ORIGINS=

# Number of proxies in front of the app (set to 1 on Hostinger/behind Nginx/Cloudflare, 0 locally)
TRUST_PROXY=1

# Cookies / sessions ---------------------------------------------------
# Leave COOKIE_DOMAIN blank unless you serve API and site on sibling subdomains
# (e.g. api.example.com + www.example.com -> COOKIE_DOMAIN=.example.com).
COOKIE_DOMAIN=
# Set COOKIE_SECURE=true in production (HTTPS). Keep false for plain-http localhost.
COOKIE_SECURE=false
# If the site and API are on different sites in production, use "none" (requires COOKIE_SECURE=true).
COOKIE_SAMESITE=lax
SESSION_TTL_DAYS=7

# Email ----------------------------------------------------------------
# All transactional email (verification, password reset, admin invites, inquiry
# notifications, newsletter) is sent through the company Gmail account below.
#
# ── Gmail setup (one-time) ─────────────────────────────────────────────
#  1. Sign in to cybernexasolution@gmail.com
#  2. Enable 2-Step Verification:  https://myaccount.google.com/security
#  3. Create an App Password:       https://myaccount.google.com/apppasswords
#     (choose "Mail" → "Other", name it e.g. "Cyber Nexa Website")
#  4. Paste the 16-character app password into SMTP_PASSWORD below (remove spaces).
#     NOTE: use the App Password, NOT the normal Gmail login password.
#
# For local development you can instead set EMAIL_PROVIDER=console to just log
# emails to the terminal without sending anything.
EMAIL_PROVIDER=smtp
EMAIL_FROM=Cyber Nexa Solution <cybernexasolution@gmail.com>
# Internal notifications go here (new inquiries, etc.). Blank falls back to Settings → Email.
ADMIN_EMAIL=cybernexasolution@gmail.com

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=cybernexasolution@gmail.com
SMTP_PASSWORD=your-16-char-gmail-app-password

# Alternative providers (leave blank when using Gmail SMTP above)
# Resend (https://resend.com) — set EMAIL_PROVIDER=resend
RESEND_API_KEY=
# SendGrid — set EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=

# File storage ---------------------------------------------------------
# Provider: local (writes to apps/api/uploads, served at /uploads), s3, or cloudinary.
# NOTE: on ephemeral hosts (Render free, Fly without a volume) local uploads are wiped on
# redeploy — use s3 or cloudinary in production.
STORAGE_PROVIDER=local
UPLOAD_MAX_MB=10

# S3 / R2 / any S3-compatible bucket — set STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# Cloudinary — set STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cybernexa

# Spam protection (optional) ------------------------------------------
# Cloudflare Turnstile secret key. If set, contact/inquiry forms require a valid token
# and the matching VITE_TURNSTILE_SITE_KEY must be set for the web app.
TURNSTILE_SECRET_KEY=

# Logging --------------------------------------------------------------
LOG_LEVEL=info
