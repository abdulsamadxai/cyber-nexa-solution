{
  "name": "cyber-nexa-solution",
  "private": true,
  "version": "1.0.0",
  "description": "Cyber Nexa Solution — corporate website, CMS, CRM-style inquiry management and admin platform",
  "workspaces": ["apps/*"],
  "engines": { "node": ">=20.19" },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "vercel-build": "npm run db:generate -w apps/api && npm --prefix apps/web run build",
    "build:web": "npm --prefix apps/web run build",
    "build:api": "npm --prefix apps/api run build",
    "typecheck": "npm run typecheck -w apps/api && npm run typecheck -w apps/web",
    "start": "npm run start -w apps/api",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:deploy": "npm run db:deploy -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:studio": "npm run db:studio -w apps/api",
    "create-admin": "npm run create-admin -w apps/api",
    "test": "npm run test -w apps/api"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^2.0.0",
    "nodemailer": "^7.0.0",
    "pg": "^8.13.1",
    "sharp": "^0.34.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vercel/node": "^5.1.8",
    "concurrently": "^9.1.0",
    "prisma": "^7.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
