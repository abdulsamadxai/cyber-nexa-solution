# ─────────────────────────────────────────────────────────────
# Cyber Nexa Solution — Production Environment (.env)
# Domain: https://cybernexasolution.com
# ─────────────────────────────────────────────────────────────

# Server Configuration
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
WEB_DIST_DIR=apps/web/dist

# PostgreSQL Database Connection
# Replace with your Hostinger or Cloud PostgreSQL credentials:
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME

# Session Secret (at least 32 characters)
SESSION_SECRET=e9b2c8a7f1d4365890abcedf1234567890abcdef1234567890abcdef12345678

# Public URLs
FRONTEND_URL=https://cybernexasolution.com
BACKEND_URL=https://cybernexasolution.com

# Reverse Proxy (Set to 1 behind Hostinger/Nginx)
TRUST_PROXY=1

# Cookies & Security
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
SESSION_TTL_DAYS=7

# Email Provider (console, resend, sendgrid, or smtp)
EMAIL_PROVIDER=console
EMAIL_FROM=Cyber Nexa Solution <cybernexasolution@gmail.com>

# File Storage (local, s3, or cloudinary)
STORAGE_PROVIDER=local
UPLOAD_MAX_MB=10

LOG_LEVEL=info
